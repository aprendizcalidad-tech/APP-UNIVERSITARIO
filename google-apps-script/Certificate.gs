function certificateText_(shape,b){
 const text=shape.getText();text.setText(b.text);
 text.getTextStyle().setFontFamily(b.font).setFontSize(b.size).setForegroundColor(b.color).setBold(b.bold);
 text.getParagraphStyle().setParagraphAlignment(SlidesApp.ParagraphAlignment.CENTER).setSpaceAbove(0).setSpaceBelow(0);
 shape.setContentAlignment(SlidesApp.ContentAlignment.MIDDLE);
 if(b.link)text.getTextStyle().setLinkUrl(b.link);
}

function prepararCertificadoPremium(){
 resetRequest_();const folderId=prop_('CERTIFICATE_FOLDER_ID');need_(folderId,'Primero debe existir la carpeta de certificados de tu instalación actual.');
 const deck=SlidesApp.create('Finnova Group — Plantilla Certificado Premium');const file=DriveApp.getFileById(deck.getId());
 try{
  file.moveTo(DriveApp.getFolderById(folderId));const slide=deck.getSlides()[0];slide.getPageElements().forEach(e=>e.remove());
  need_(Math.abs(deck.getPageWidth()/deck.getPageHeight()-720/405)<0.01,'La plantilla requiere formato panorámico 16:9.');
  slide.insertImage(certificateBackground_(),0,0,720,405);
  const sample={...settings_(),name:'Nombre del participante',title:'Nombre del curso',hours:2,date:now_(),code:'VISTA PREVIA'};
  UC_CERTIFICATE.layout(sample).forEach(b=>{const shape=slide.insertTextBox(b.text,b.x,b.y,b.w,b.h);shape.setTitle('uc_'+b.id);certificateText_(shape,b);});
  // Logo principal Finnova.
  slide.insertImage(certificateCompanyLogo_(),274,18,172,52);
  // El logo de la empresa funciona como firma institucional.
  slide.insertImage(certificateCompanyLogo_(),132,320,176,53);
  deck.saveAndClose();
  const props=PropertiesService.getScriptProperties();props.setProperty('CERTIFICATE_PREMIUM_TEMPLATE_ID',file.getId());props.setProperty('CERTIFICATE_PREMIUM_TEMPLATE_VERSION',UC_CERTIFICATE_VERSION);
  console.log('Plantilla Finnova lista: '+file.getUrl());return file.getId();
 }catch(error){file.setTrashed(true);throw error;}
}

function premiumTemplateId_(){
 let id=prop_('CERTIFICATE_PREMIUM_TEMPLATE_ID'),version=prop_('CERTIFICATE_PREMIUM_TEMPLATE_VERSION');
 if(id&&version===UC_CERTIFICATE_VERSION){try{DriveApp.getFileById(id).getName();return id;}catch(_e){}}
 prepararCertificadoPremium();return prop_('CERTIFICATE_PREMIUM_TEMPLATE_ID');
}

function generatePremiumPdf_(c){
 const templateId=premiumTemplateId_();const folder=DriveApp.getFolderById(prop_('CERTIFICATE_FOLDER_ID'));const previousFileId=c.fileId||'';
 const copy=DriveApp.getFileById(templateId).makeCopy('Temporal '+c.code,folder);
 try{
  const deck=SlidesApp.openById(copy.getId()),shapes=deck.getSlides()[0].getShapes();
  UC_CERTIFICATE.layout(c).forEach(b=>{const shape=shapes.find(s=>s.getTitle()==='uc_'+b.id);need_(shape,'Falta el campo '+b.id+' en la plantilla. Vuelve a prepararla.');certificateText_(shape,b);});
  deck.saveAndClose();const pdf=copy.getAs(MimeType.PDF).setName(c.code+'.pdf');const file=folder.createFile(pdf);
  const updated={...c,fileId:file.getId(),designVersion:UC_CERTIFICATE_VERSION};
  try{put_('Certificates',updated);}catch(error){file.setTrashed(true);throw error;}
  Object.assign(c,updated);
  if(previousFileId&&previousFileId!==file.getId()){try{DriveApp.getFileById(previousFileId).setTrashed(true);}catch(_e){}}
 }finally{copy.setTrashed(true);}
}
